mode systems

import "std/test" as t
import "../src/advi.tw" as advi
import "../src/dist.tw" as dist
import "../src/vec.tw" as vec

fn std_normal(q: Tensor) -> Tensor = dist.normal_log_prob(q, scalar(0.0), scalar(1.0))

# A target the mean field family can represent exactly, so the fit should be
# exact up to optimisation error. This is the only case where ADVI's answer can
# be checked rather than merely inspected.
fn a_diagonal_normal_target(q: Tensor) -> Tensor =
  dist.normal_log_prob(q, [2.0, -1.0], [0.5, 3.0])

# A correlated target, where mean field cannot be exact and the direction of
# its error is a known fact rather than a matter of luck.
fn a_correlated_normal_target(q: Tensor) -> Tensor {
  # Correlation 0.95, unit marginals.
  let l: Tensor = [[1.0, 0.0], [0.95, 0.31224989991991997]]
  dist.mvnormal_log_prob(q, [0.0, 0.0], l, 2)
}

fn advi_recovers_a_target_its_family_contains() {
  let cfg = advi.advi_config(4000, 20260807)
  let res = advi.advi_fit(a_diagonal_normal_target, [0.0, 0.0], cfg)

  t.near("mean of the first coordinate", res.mu[0], 2.0, 0.1)
  t.near("mean of the second", res.mu[1], -1.0, 0.3)
  t.near("sd of the first", f64_exp(res.omega[0]), 0.5, 0.1)
  t.near("sd of the second", f64_exp(res.omega[1]), 3.0, 0.5)
}

fn the_evidence_lower_bound_increases() {
  let cfg = advi.advi_config(2000, 11)
  let res = advi.advi_fit(a_diagonal_normal_target, [5.0, 5.0], cfg)

  # Compared as window means, because a single-iteration ELBO is a one-sample
  # Monte Carlo estimate and is noisy enough to fall at any given step.
  let early: F64 = advi.window_mean(res.elbo, 0, 100)
  let late: F64 = advi.window_mean(res.elbo, len(res.elbo) - 100, 100)
  t.check("the objective improved", late > early)
}

fn the_lower_bound_is_a_lower_bound_on_the_log_evidence() {
  # For a normalised target the log evidence is exactly zero, so a correct ELBO
  # must be at or below zero. An ELBO that comes out positive means a sign
  # error in the entropy, which is the easiest thing in the file to get wrong
  # and produces an optimiser that runs away.
  let cfg = advi.advi_config(2000, 12)
  let res = advi.advi_fit(a_diagonal_normal_target, [0.0, 0.0], cfg)
  let final_elbo: F64 = advi.window_mean(res.elbo, len(res.elbo) - 100, 100)
  t.check("the ELBO stays below the log evidence", final_elbo < 0.2)
  t.check("and gets close to it for an exactly representable target",
    final_elbo > -0.5)
}

fn the_entropy_is_the_closed_form_for_a_mean_field_normal() {
  # H = sum(omega) + (d/2)(1 + log 2pi). At omega = 0 and d = 2 that is
  # 1 + log(2 pi) = 2.8378770664093453.
  let h: F64 = item(advi.entropy([0.0, 0.0], 2))
  t.near("the mean field entropy at unit scale", h, 2.8378770664093453, 0.000000000001)
  # Doubling every standard deviation adds d * log(2).
  let h2: F64 = item(advi.entropy([0.6931471805599453, 0.6931471805599453], 2))
  t.near("entropy grows with the log scale", h2 - h, 2.0 * 0.6931471805599453,
    0.000000000001)
}

# THE FAILURE MODE, ASSERTED RATHER THAN DESCRIBED.
#
# KL(q || p) punishes q for putting mass where p has none and not the reverse,
# so the fitted q shrinks into the posterior. On a target with correlation 0.95
# the true marginal standard deviation is 1 and mean field gets roughly
# sqrt(1 - 0.95^2) = 0.31. Testing for it means a user who reads the tests
# learns the limitation from the code rather than from a footnote.
fn mean_field_understates_the_variance_of_a_correlated_posterior() {
  let cfg = advi.advi_config(6000, 13)
  let res = advi.advi_fit(a_correlated_normal_target, [0.0, 0.0], cfg)

  t.near("the mean is still about right", res.mu[0], 0.0, 0.2)
  t.check("but the width is far too small", f64_exp(res.omega[0]) < 0.6)
  t.check("and it is close to the conditional standard deviation",
    f64_exp(res.omega[0]) > 0.15)
}

fn the_fit_converges_and_says_so() {
  let cfg = advi.advi_config(20000, 14)
  let res = advi.advi_fit(std_normal, [0.0, 0.0], cfg)
  t.check("convergence was declared", res.converged)
  t.check("before the iteration cap", res.iterations < 20000)
}

fn the_fitted_mean_is_a_usable_starting_point() {
  let cfg = advi.advi_config(3000, 15)
  let res = advi.advi_fit(a_diagonal_normal_target, [10.0, 10.0], cfg)
  let init: Arr[F64] = advi.advi_init(res)
  t.near("the starting point is near the mode", init[0], 2.0, 0.15)
  t.near("in both coordinates", init[1], -1.0, 0.4)
}

fn the_fitted_scales_make_a_plausible_initial_metric() {
  let cfg = advi.advi_config(3000, 16)
  let res = advi.advi_fit(a_diagonal_normal_target, [0.0, 0.0], cfg)
  let im: Arr[F64] = advi.advi_inv_mass(res)
  # inv_mass should be the variance, so 0.25 and 9.
  t.near("the first coordinate's inverse mass", im[0], 0.25, 0.1)
  t.check("the second is much larger", im[1] > 4.0)
}

fn draws_from_the_fit_have_the_fitted_moments() {
  let cfg = advi.advi_config(3000, 17)
  let res = advi.advi_fit(a_diagonal_normal_target, [0.0, 0.0], cfg)
  let ds: Arr[Arr[F64]] = advi.advi_draws(res, 20000, 999)

  let s: F64 = 0.0
  let s2: F64 = 0.0
  let i: I64 = 0
  while i < len(ds) {
    s = s + ds[i][0]
    s2 = s2 + ds[i][0] * ds[i][0]
    i = i + 1
  }
  let m: F64 = s / f64_of_i64(len(ds))
  t.near("the draws have the fitted mean", m, res.mu[0], 0.02)
  t.near("and the fitted standard deviation",
    f64_sqrt(s2 / f64_of_i64(len(ds)) - m * m), f64_exp(res.omega[0]), 0.02)
}

advi_recovers_a_target_its_family_contains()
the_evidence_lower_bound_increases()
the_lower_bound_is_a_lower_bound_on_the_log_evidence()
the_entropy_is_the_closed_form_for_a_mean_field_normal()
mean_field_understates_the_variance_of_a_correlated_posterior()
the_fit_converges_and_says_so()
the_fitted_mean_is_a_usable_starting_point()
the_fitted_scales_make_a_plausible_initial_metric()
draws_from_the_fit_have_the_fitted_moments()

t.report("heddle advi")
