mode systems

import "std/test" as t
import "../src/dist.tw" as dist
import "../src/vec.tw" as vec

import "std/random" as random

# An analytic derivative against a central difference. Local to this file
# rather than in a shared helper: a helper that imports std/test gets its own
# counter, and a failure it recorded would never reach this file's report. The
# central difference is deliberate: with h = 1e-5 it agrees to about 1e-10
# where a forward difference agrees to about 1e-5, which is not tight enough
# to catch a wrong sign on a small term.
fn near_grad(name: Str, analytic: F64, plus: F64, minus: F64, h: F64, tol: F64) {
  t.near(name, analytic, (plus - minus) / (2.0 * h), tol)
}

# The densities are checked three ways, because each catches a different class
# of error.
#
#   Against a known value. Catches a wrong constant.
#   Against the integral, by summing a fine grid. Catches a density that is not
#     normalised, which is what a wrong constant produces and what a dropped
#     lgamma term produces.
#   Against a finite difference of the gradient. Catches nothing about the
#     density and everything about whether `grad` sees through it, which is the
#     claim the whole library rests on.

fn the_standard_normal_density_at_zero_is_the_known_constant() {
  # log(1/sqrt(2 pi)) = -0.9189385332046727
  let v: F64 = vec.scalar_of(dist.normal_log_prob(scalar(0.0), scalar(0.0), scalar(1.0)))
  t.near("standard normal at 0", v, -0.9189385332046727, 0.000000000001)
}

fn a_normal_density_scales_by_its_standard_deviation_and_not_its_variance() {
  # Doubling sigma subtracts log(2) from the density at the mean.
  let a: F64 = vec.scalar_of(dist.normal_log_prob(scalar(0.0), scalar(0.0), scalar(1.0)))
  let b: F64 = vec.scalar_of(dist.normal_log_prob(scalar(0.0), scalar(0.0), scalar(2.0)))
  t.near("sigma is a standard deviation", a - b, 0.6931471805599453, 0.000000000001)
}

fn a_vector_normal_density_is_the_sum_over_its_elements() {
  let y: Tensor = [1.0, -1.0, 0.5]
  let together: F64 = vec.scalar_of(dist.normal_log_prob(y, scalar(0.0), scalar(1.0)))
  let apart: F64 = vec.scalar_of(dist.normal_log_prob(scalar(1.0), scalar(0.0), scalar(1.0)))
    + vec.scalar_of(dist.normal_log_prob(scalar(-1.0), scalar(0.0), scalar(1.0)))
    + vec.scalar_of(dist.normal_log_prob(scalar(0.5), scalar(0.0), scalar(1.0)))
  t.near("vector density sums", together, apart, 0.000000000001)
}

fn a_bernoulli_logit_density_matches_its_stable_softplus_form() {
  # log p(y | z) = sum(y*z - softplus(z)). For y = [1, 0] and z = [2, -1]:
  # (2 - log(1 + e^2)) + (0 - log(1 + e^-1)) = -0.126928 - 0.313262 = -0.440190.
  let lp: F64 = vec.scalar_of(dist.bernoulli_logit_log_prob([1.0, 0.0], [2.0, -1.0]))
  t.near("bernoulli logit density", lp, -0.440190, 0.00001)
}

fn a_poisson_log_density_matches_the_count_formula() {
  # log p(y | log_lambda) = sum(y*log_lambda - lambda - log(y!)). For y = [2, 0]
  # and log_lambda = [log 3, 0]: (2*log3 - 3 - log2) + (0 - 1 - 0)
  # = -1.495923 - 1 = -2.495923.
  let lp: F64 = vec.scalar_of(
    dist.poisson_log_log_prob([2.0, 0.0], [1.0986122886681098, 0.0]))
  t.near("poisson log density", lp, -2.495923, 0.00001)
}

fn the_gradient_of_a_normal_density_matches_a_finite_difference() {
  let h: F64 = 0.00001
  let f = fn(y: Tensor) -> Tensor = dist.normal_log_prob(y, scalar(0.3), scalar(1.7))
  let g: F64 = item(grad(f)(scalar(1.1)))
  near_grad("d/dy normal log density",
    g,
    vec.scalar_of(f(scalar(1.1 + h))),
    vec.scalar_of(f(scalar(1.1 - h))),
    h, 0.0000001)
}

# The one that matters most. A model puts a prior on sigma and the sampler
# moves sigma, so the density has to be differentiable in the parameter and not
# only in the value.
fn the_gradient_of_a_normal_density_with_respect_to_sigma_matches() {
  let h: F64 = 0.00001
  let f = fn(s: Tensor) -> Tensor = dist.normal_log_prob(scalar(1.1), scalar(0.3), s)
  let g: F64 = item(grad(f)(scalar(1.7)))
  near_grad("d/dsigma normal log density",
    g,
    vec.scalar_of(f(scalar(1.7 + h))),
    vec.scalar_of(f(scalar(1.7 - h))),
    h, 0.0000001)
}

fn the_half_normal_carries_twice_the_normal_density() {
  let a: F64 = vec.scalar_of(dist.half_normal_log_prob(scalar(0.7), scalar(1.3)))
  let b: F64 = vec.scalar_of(dist.normal_log_prob(scalar(0.7), scalar(0.0), scalar(1.3)))
  t.near("half normal is twice the normal", a - b, 0.6931471805599453, 0.000000000001)
}

fn the_lognormal_density_is_the_normal_density_minus_the_log_jacobian() {
  # log p_Y(y) = log p_X(log y) - log y. Checking the identity rather than a
  # value, because the identity is the thing the file's comment claims and
  # therefore the thing a reader will rely on.
  let y: F64 = 2.5
  let a: F64 = vec.scalar_of(dist.lognormal_log_prob(scalar(y), scalar(0.2), scalar(0.9)))
  let b: F64 = vec.scalar_of(dist.normal_log_prob(scalar(f64_log(y)), scalar(0.2), scalar(0.9)))
  t.near("lognormal is normal on the log minus log y", a, b - f64_log(y), 0.000000000001)
}

fn log_gamma_agrees_with_the_known_factorials() {
  # lgamma(n) = log((n-1)!). 5! = 120.
  t.near("lgamma(6) is log(120)", item(dist.lgamma(scalar(6.0))), f64_log(120.0), 0.0000000001)
  t.near("lgamma(1) is 0", item(dist.lgamma(scalar(1.0))), 0.0, 0.0000000001)
  # lgamma(1/2) = log(sqrt(pi))
  t.near("lgamma(0.5) is log sqrt pi", item(dist.lgamma(scalar(0.5))),
    0.5723649429247001, 0.0000000001)
}

# The reason `lgamma` was rewritten over tensors rather than reused from
# std/stats. A shape parameter that gets a zero gradient is a shape parameter
# that never moves, and the trace plot for it is a flat line that looks like a
# very well identified parameter.
fn log_gamma_has_a_gradient_and_it_is_the_digamma() {
  let h: F64 = 0.00001
  let g: F64 = item(grad(dist.lgamma)(scalar(3.0)))
  t.check("lgamma has a nonzero gradient", g > 0.5)
  near_grad("d/dx lgamma at 3",
    g,
    item(dist.lgamma(scalar(3.0 + h))),
    item(dist.lgamma(scalar(3.0 - h))),
    h, 0.0000001)
}

fn the_beta_density_integrates_to_one() {
  # A Riemann sum over (0,1) on a fine grid. Coarse enough to run and fine
  # enough that a missing normalising constant, which would be off by a factor
  # of B(a,b), cannot hide in the quadrature error.
  let a: F64 = 2.0
  let b: F64 = 3.0
  let n: I64 = 20000
  let total: F64 = 0.0
  let i: I64 = 1
  while i < n {
    let x: F64 = f64_of_i64(i) / f64_of_i64(n)
    total = total + f64_exp(item(dist.beta_log_prob(scalar(x), scalar(a), scalar(b))))
    i = i + 1
  }
  t.near("beta(2,3) integrates to one", total / f64_of_i64(n), 1.0, 0.001)
}

fn the_gamma_density_integrates_to_one() {
  let shape: F64 = 2.5
  let scale: F64 = 1.5
  let n: I64 = 40000
  let hi: F64 = 40.0
  let total: F64 = 0.0
  let i: I64 = 1
  while i < n {
    let x: F64 = hi * f64_of_i64(i) / f64_of_i64(n)
    total = total + f64_exp(item(dist.gamma_log_prob(scalar(x), scalar(shape), scalar(scale))))
    i = i + 1
  }
  t.near("gamma(2.5, 1.5) integrates to one", total * hi / f64_of_i64(n), 1.0, 0.001)
}

fn the_student_t_approaches_the_normal_as_nu_grows() {
  let a: F64 = item(dist.student_t_log_prob(scalar(1.0), scalar(1000000.0), scalar(0.0), scalar(1.0)))
  let b: F64 = item(dist.normal_log_prob(scalar(1.0), scalar(0.0), scalar(1.0)))
  t.near("t with huge nu is the normal", a, b, 0.00001)
}

fn the_student_t_has_heavier_tails_than_the_normal() {
  let a: F64 = item(dist.student_t_log_prob(scalar(6.0), scalar(3.0), scalar(0.0), scalar(1.0)))
  let b: F64 = item(dist.normal_log_prob(scalar(6.0), scalar(0.0), scalar(1.0)))
  t.check("t(3) puts far more mass at six sigma than the normal", a > b + 5.0)
}

fn the_dirichlet_reduces_to_the_beta_in_two_dimensions() {
  # Dirichlet(a, b) on (y, 1-y) is Beta(a, b) on y, and the densities are equal
  # because the Jacobian of the reduction is one.
  let y: Tensor = [0.3, 0.7]
  let alpha: Tensor = [2.0, 5.0]
  let a: F64 = item(dist.dirichlet_log_prob(y, alpha))
  let b: F64 = item(dist.beta_log_prob(scalar(0.3), scalar(2.0), scalar(5.0)))
  t.near("dirichlet in two dimensions is the beta", a, b, 0.000000000001)
}

fn a_categorical_density_normalises_its_logits() {
  # Adding a constant to every logit must not change the density. This is the
  # property that makes taking logits rather than probabilities safe, and it
  # fails immediately if the logsumexp is dropped.
  let l1: Tensor = [1.0, 2.0, 3.0]
  let l2: Tensor = [101.0, 102.0, 103.0]
  t.near("categorical is shift invariant in its logits",
    item(dist.categorical_log_prob(l1, 1)),
    item(dist.categorical_log_prob(l2, 1)), 0.0000000001)
}

fn a_categorical_density_sums_to_one_over_its_categories() {
  let l: Tensor = [0.5, -1.2, 2.0, 0.0]
  let total: F64 = 0.0
  let k: I64 = 0
  while k < 4 {
    total = total + f64_exp(item(dist.categorical_log_prob(l, k)))
    k = k + 1
  }
  t.near("categorical probabilities sum to one", total, 1.0, 0.000000000001)
}

fn a_multinomial_of_one_trial_is_a_categorical() {
  let counts: Tensor = [0.0, 1.0, 0.0]
  let logits: Tensor = [0.4, 1.1, -0.3]
  t.near("multinomial with n=1 is the categorical",
    item(dist.multinomial_log_prob(counts, logits)),
    item(dist.categorical_log_prob(logits, 1)), 0.0000000001)
}

fn a_multivariate_normal_with_an_identity_factor_is_independent_normals() {
  let y: Tensor = [1.0, -0.5]
  let mu: Tensor = [0.0, 0.0]
  let l: Tensor = [[1.0, 0.0], [0.0, 1.0]]
  let a: F64 = item(dist.mvnormal_log_prob(y, mu, l, 2))
  let b: F64 = item(dist.normal_log_prob(y, mu, scalar(1.0)))
  t.near("identity Cholesky gives independent standard normals", a, b, 0.000000000001)
}

fn a_multivariate_normal_log_determinant_uses_the_diagonal_of_the_factor() {
  # Sigma = L L' with L = diag(2, 3), so the density at the mean is
  # -log(2) - log(3) - log(2 pi).
  let l: Tensor = [[2.0, 0.0], [0.0, 3.0]]
  let v: F64 = item(dist.mvnormal_log_prob([0.0, 0.0], [0.0, 0.0], l, 2))
  t.near("mvn log determinant is the sum of log diag L",
    v, 0.0 - f64_log(2.0) - f64_log(3.0) - 1.8378770664093453, 0.000000000001)
}

fn the_multivariate_normal_gradient_flows_into_the_cholesky_factor() {
  # The reason the triangular solve is written out rather than delegated to
  # std/linalg: the factor is a parameter and its gradient is what moves it.
  let h: F64 = 0.00001
  let f = fn(a: Tensor) -> Tensor {
    let l: Tensor = concat([reshape(concat([a, reshape(scalar(0.0), 1)], 0), 1, 2),
                                    reshape([0.4, 1.2], 1, 2)], 0)
    dist.mvnormal_log_prob([1.0, -0.5], [0.0, 0.0], l, 2)
  }
  let g: F64 = item(grad(f)(reshape(scalar(1.3), 1))[0])
  near_grad("d/dL00 of the mvn log density",
    g,
    item(f(reshape(scalar(1.3 + h), 1))),
    item(f(reshape(scalar(1.3 - h), 1))),
    h, 0.0000001)
}

# ---- samplers ---------------------------------------------------------------
#
# A sampler is checked by its moments over many draws, which is a weak test and
# the only one available. The tolerances are set from the standard error of the
# mean at the given count, so a failure means a real bias rather than a bad
# draw.

fn the_gamma_sampler_has_the_right_mean_and_variance() {
  let r: random.Rng = random.new_rng(20260807)
  let shape: F64 = 3.0
  let scale: F64 = 2.0
  let n: I64 = 40000
  let s: F64 = 0.0
  let s2: F64 = 0.0
  let i: I64 = 0
  while i < n {
    let x: F64 = dist.gamma_sample(r, shape, scale)
    s = s + x
    s2 = s2 + x * x
    i = i + 1
  }
  let m: F64 = s / f64_of_i64(n)
  let v: F64 = s2 / f64_of_i64(n) - m * m
  t.near("gamma mean is shape*scale", m, 6.0, 0.1)
  t.near("gamma variance is shape*scale^2", v, 12.0, 0.5)
}

# The boosted branch. Shape below one is where the naive implementations are
# wrong, because the density is unbounded at zero.
fn the_gamma_sampler_handles_a_shape_below_one() {
  let r: random.Rng = random.new_rng(11)
  let n: I64 = 40000
  let s: F64 = 0.0
  let i: I64 = 0
  while i < n {
    s = s + dist.gamma_sample(r, 0.3, 1.0)
    i = i + 1
  }
  t.near("gamma(0.3, 1) has mean 0.3", s / f64_of_i64(n), 0.3, 0.01)
}

fn a_dirichlet_draw_lies_on_the_simplex() {
  let r: random.Rng = random.new_rng(7)
  let alpha: Arr[F64] = [1.5, 0.5, 3.0, 2.0]
  let y: Arr[F64] = dist.dirichlet_sample(r, alpha)
  let total: F64 = 0.0
  let i: I64 = 0
  while i < len(y) {
    t.check("every dirichlet component is positive", y[i] > 0.0)
    total = total + y[i]
    i = i + 1
  }
  t.near("a dirichlet draw sums to one", total, 1.0, 0.000000000001)
}

fn a_multinomial_draw_spends_exactly_its_trials() {
  let r: random.Rng = random.new_rng(99)
  let probs: Arr[F64] = [0.1, 0.2, 0.3, 0.4]
  let counts: Arr[I64] = dist.multinomial_sample(r, 500, probs)
  let total: I64 = 0
  let i: I64 = 0
  while i < len(counts) {
    total = total + counts[i]
    i = i + 1
  }
  t.equal_i64("the counts sum to n", total, 500)
  t.equal_i64("there is one count per category", len(counts), 4)
}

the_standard_normal_density_at_zero_is_the_known_constant()
a_normal_density_scales_by_its_standard_deviation_and_not_its_variance()
a_vector_normal_density_is_the_sum_over_its_elements()
a_bernoulli_logit_density_matches_its_stable_softplus_form()
a_poisson_log_density_matches_the_count_formula()
the_gradient_of_a_normal_density_matches_a_finite_difference()
the_gradient_of_a_normal_density_with_respect_to_sigma_matches()
the_half_normal_carries_twice_the_normal_density()
the_lognormal_density_is_the_normal_density_minus_the_log_jacobian()
log_gamma_agrees_with_the_known_factorials()
log_gamma_has_a_gradient_and_it_is_the_digamma()
the_beta_density_integrates_to_one()
the_gamma_density_integrates_to_one()
the_student_t_approaches_the_normal_as_nu_grows()
the_student_t_has_heavier_tails_than_the_normal()
the_dirichlet_reduces_to_the_beta_in_two_dimensions()
a_categorical_density_normalises_its_logits()
a_categorical_density_sums_to_one_over_its_categories()
a_multinomial_of_one_trial_is_a_categorical()
a_multivariate_normal_with_an_identity_factor_is_independent_normals()
a_multivariate_normal_log_determinant_uses_the_diagonal_of_the_factor()
the_multivariate_normal_gradient_flows_into_the_cholesky_factor()
the_gamma_sampler_has_the_right_mean_and_variance()
the_gamma_sampler_handles_a_shape_below_one()
a_dirichlet_draw_lies_on_the_simplex()
a_multinomial_draw_spends_exactly_its_trials()

t.report("heddle dist")
